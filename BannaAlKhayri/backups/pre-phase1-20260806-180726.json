{"ID":3832,"post_content":"<p><strong>Notice:<\/strong> Test mode is enabled. While in test mode no live donations are processed.<\/p>\t\t\t<form id=\"give-form-6558-1\" action=\"https:\/\/wordpress.themehour.net\/donat\/?payment-mode=manual&form-id=6558\" data-id=\"6558-1\" data-currency_symbol=\"&#36;\" data-currency_code=\"USD\" data-currency_position=\"before\" data-thousands_separator=\",\" data-decimal_separator=\".\" data-number_decimals=\"2\" method=\"post\">\n\t\t\t\t<!-- The following field is for robots only, invisible to humans: -->\n\t\t\t\t\t<label for=\"give-form-honeypot-6558\"><\/label>\n\t\t\t\t\t<input id=\"give-form-honeypot-6558\" type=\"text\" name=\"give-honeypot\"\n\t\t\t\t\t\t  \/>\n\t\t\t\t\t<input type=\"hidden\" name=\"give-form-id-prefix\" value=\"6558-1\"\/>\n\t<input type=\"hidden\" name=\"give-form-id\" value=\"6558\"\/>\n\t<input type=\"hidden\" name=\"give-form-title\" value=\"Medical Health or People React Acuter.\"\/>\n\t<input type=\"hidden\" name=\"give-current-url\" value=\"https:\/\/wordpress.themehour.net\/donat\/\"\/>\n\t<input type=\"hidden\" name=\"give-form-url\" value=\"https:\/\/wordpress.themehour.net\/donat\/\"\/>\n\t\t\t<input type=\"hidden\" name=\"give-form-minimum\"\n\t\t\t   value=\"25.00\"\/>\n\t\t<input type=\"hidden\" name=\"give-form-maximum\"\n\t\t\t   value=\"999999.99\"\/>\n\t\t<input type=\"hidden\"  name=\"give-form-hash\" value=\"421029cb37\" data-time=\"1758716756\" data-nonce-life=\"86400\" data-donor-session=\"0\"\/><input type=\"hidden\" name=\"give-price-id\" value=\"3\"\/>\t\t\n\t\t\t\t&#036;\t\t\t\t<label for=\"give-amount\">Donation Amount:<\/label>\n\t\t\t\t<input id=\"give-amount\" name=\"give-amount\" type=\"text\" inputmode=\"decimal\"\n\t\t\t\t\t   placeholder=\"\" value=\"100.00\" autocomplete=\"off\">\n\t\t<ul id=\"give-donation-level-button-wrap\"><li><button type=\"button\" data-price-id=\"0\" value=\"10.00\" data-default=\"0\">&#036;10.00<\/button><\/li><li><button type=\"button\" data-price-id=\"1\" value=\"25.00\" data-default=\"0\">&#036;25.00<\/button><\/li><li><button type=\"button\" data-price-id=\"2\" value=\"50.00\" data-default=\"0\">&#036;50.00<\/button><\/li><li><button type=\"button\" data-price-id=\"3\" value=\"100.00\" data-default=\"1\">&#036;100.00<\/button><\/li><li><button type=\"button\" data-price-id=\"5\" value=\"250.00\" data-default=\"0\">&#036;250.00<\/button><\/li><li><button type=\"button\" data-price-id=\"custom\" value=\"custom\">Custom Amount<\/button><\/li><\/ul><button type=\"button\">Donate Now<\/button>\n\t<fieldset id=\"give-payment-mode-select\">\n\t\t\t\t<legend\n\t\t\tclass=\"give-payment-mode-label\">Select Payment Method\t\t\t\n\t\t<\/legend>\n\t\t\t\t\t\t<ul id=\"give-gateway-radio-list\">\n\t\t\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<input type=\"radio\" name=\"payment-mode\"\n\t\t\t\t\t\t\t\t   id=\"give-gateway-manual-6558-1\"\n\t\t\t\t\t\t\t\t   value=\"manual\" checked='checked'>\n\t\t\t\t\t\t\t<label for=\"give-gateway-manual-6558-1\"\n\t\t\t\t\t\t\t\t   id=\"give-gateway-option-manual\"> Test Donation<\/label>\n\t\t\t\t\t\t<\/li>\n\t\t\t\t\t\t\t\t\t\t\t\t<li>\n\t\t\t\t\t\t\t<input type=\"radio\" name=\"payment-mode\"\n\t\t\t\t\t\t\t\t   id=\"give-gateway-offline-6558-1\"\n\t\t\t\t\t\t\t\t   value=\"offline\">\n\t\t\t\t\t\t\t<label for=\"give-gateway-offline-6558-1\"\n\t\t\t\t\t\t\t\t   id=\"give-gateway-option-offline\"> Offline Donation<\/label>\n\t\t\t\t\t\t<\/li>\n\t\t\t\t\t\t\t\t\t<\/ul>\n\t\t\t<\/fieldset>\n\t\t\t<fieldset id=\"give_checkout_user_info\">\n\t\t<legend>\n\t\t\tPersonal Info\t\t<\/legend>\n        <p id=\"give-first-name-wrap\">\n            <label for=\"give-first\">\n                First Name                                    *\n                                            <\/label>\n            <input\n                type=\"text\"\n                name=\"give_first\"\n                autocomplete=\"given-name\"\n                placeholder=\"First Name\"\n                id=\"give-first\"\n                value=\"\"\n                 required aria-required=\"true\"             \/>\n        <\/p>\n        <p id=\"give-last-name-wrap\">\n            <label for=\"give-last\">\n                Last Name                                            <\/label>\n            <input\n                type=\"text\"\n                name=\"give_last\"\n                autocomplete=\"family-name\"\n                id=\"give-last\"\n                placeholder=\"Last Name\"\n                value=\"\"\n                            \/>\n        <\/p>\n                <p id=\"give-email-wrap\">\n            <label for=\"give-email\">\n                Email Address                                    *\n                                                <\/label>\n            <input\n                type=\"email\"\n                name=\"give_email\"\n                autocomplete=\"email\"\n                placeholder=\"Email Address\"\n                id=\"give-email\"\n                value=\"themeholy@gmail.com\"\n                 required aria-required=\"true\"             \/>\n        <\/p>\n\t\t\t\t\t<\/fieldset>\n\t\t<fieldset id=\"give_purchase_submit\">\n\t\t\t<p id=\"give-final-total-wrap\">\n\t\t\tDonation Total:\t\t\n\t\t\t&#36;100.00\t\t\n\t\t\t<\/p>\n\t\t\t<input type=\"hidden\" name=\"give-user-id\" value=\"1\"\/>\n\t\t<input type=\"hidden\" name=\"give_action\" value=\"purchase\"\/>\n\t<input type=\"hidden\" name=\"give-gateway\" value=\"manual\"\/>\n\t\t<input type=\"submit\" id=\"give-purchase-button\" name=\"give-purchase\"\n\t\t\t   value=\"Donate Now\" data-before-validation-label=\"Donate Now\"\/>\n\t\t<\/fieldset>\n\t\t\t\t<\/form>\n\t<!--end #give-form-6558-->\n\t\t\t\t\tOrganizer:<img src=\"https:\/\/wordpress.themeholy.com\/donat\/wp-content\/uploads\/2024\/10\/blog-author.png\" alt=\"blog author\"  \/><h4><a href=\"https:\/\/wordpress.themeholy.com\/donat\/volunteer-details\/\">Emanuel Marko<\/a><\/h4><a href=\"https:\/\/wordpress.themehol